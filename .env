# AI Provider Configuration
# Copy this file to .env and add your actual API keys

# Google Gemini Pro (RECOMMENDED - FREE!)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCLITYK27zd344KDku8ai84ku0AD8FRKZU

# OpenAI (Optional - Requires billing)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SOURCE DATABASE (DigiSpace CNA - Read Only)
# This is your existing production database
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5433
SOURCE_DB_DATABASE=db_digispace_cna_augustus_182025
SOURCE_DB_USERNAME=postgres
SOURCE_DB_PASSWORD=

# THESIS DATABASE (MPCIM - Read/Write)
# Option 1: PostgreSQL (create new database on same server)
THESIS_DATABASE_URL=postgresql://postgres:@localhost:5432/mpcim_thesis

# Option 2: SQLite (for testing/development)
# THESIS_DATABASE_URL=sqlite:///./mpcim_thesis.db

# Alternative: Use same as thesis database
DATABASE_URL=postgresql://postgres:@localhost:5432/mpcim_thesis

# Connection Pool Settings (PostgreSQL only)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Debug Mode (set to true to see SQL queries)
DATABASE_ECHO=false
